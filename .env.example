# Copy to .env and fill in. Never commit the real file.
# One provider key covers both embeddings and answers.
OPENAI_API_KEY=

# Supabase project the API talks to. The service role key stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pooled Postgres connection string for the same project. The API uses this
# rather than PostgREST, because row-level security needs the session claim set
# inside the transaction and the service role key would bypass the policies.
SUPABASE_DB_URL=
