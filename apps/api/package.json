{
  "name": "@acb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "dev:real": "tsx watch src/dev-real.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "templates:load": "tsx ../../scripts/load-templates.ts",
    "eval": "tsx ../../scripts/eval.ts"
  },
  "dependencies": {
    "@acb/schemas": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "postgres": "^3.4.9",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
